# @BotFather tarafından verilen Telegram bot tokenı
TELEGRAM_BOT_TOKEN=

# Yerel varsayılan; Render üzerinde dosya sistemi ephemeral olduğu için kalıcı DB kullanın
DATABASE_PATH=./data/nexa.sqlite3

# CoinGecko Demo anahtarı opsiyoneldir; keyless kullanım IP bazlı limit paylaşır
COINGECKO_DEMO_API_KEY=

# Yerel polling ile kullanacaksanız true; dış GitHub Actions cron ile false
ENABLE_INTERNAL_SCHEDULER=true
ALARM_CHECK_INTERVAL_SECONDS=60

# Yahoo BIST taraması için açıkça seçilmiş örnek evren; gerektiğinde değiştirin
BIST_UNIVERSE=THYAO,ASELS,AKBNK,EREGL,TUPRS,BIMAS,SISE,TCELL,KOZAL,PGSUS

LOG_LEVEL=INFO

# Render webhook dağıtımı
APP_BASE_URL=
TELEGRAM_WEBHOOK_SECRET=

# /internal/cron endpoint'i için uzun, rastgele bir sır
CRON_SECRET=
